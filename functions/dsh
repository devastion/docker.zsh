#!/usr/bin/env zsh

dsh() {
  emulate -L zsh -o pipe_fail

  (($# <= 1)) || {
    print -u2 -r -- 'Usage: dsh [container]'
    return 2
  }
  local running
  running="$(docker ps -q)" || return
  [[ -n "${running}" ]] || {
    print -u2 -r -- 'No docker containers running!'
    return 1
  }

  local container_id selected line
  local -a containers=()

  if [[ -n "${1}" ]]; then
    containers=("${(@f)$(docker ps --format '{{.ID}}\t{{.Names}}')}") || return
    for line in "$containers[@]"; do
      if [[ "${line#*$'\t'}" == "${1}" ]]; then
        container_id="${line%%$'\t'*}"
        break
      fi
    done
  else
    ((${+commands[fzf]})) || {
      print -u2 -r -- 'dsh: fzf not found'
      return 127
    }
    selected="$(
      docker ps --format '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}' |
        fzf -1
    )" || return 1
    container_id="${selected%%$'\t'*}"
  fi

  if [[ -z "${container_id}" ]]; then
    print -u2 -r -- "Couldn't find container id"
    return 1
  fi

  docker exec -e TERM -e COLORTERM -e LC_ALL=C.UTF-8 -it "${container_id}" sh -c \
    'if [ -x /bin/bash ]; then exec /bin/bash; else exec /bin/sh; fi'
}

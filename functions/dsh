#!/usr/bin/env zsh
# desc: Open a shell in a running container (pick with fzf when no argument)

dsh() {
  emulate -L zsh -o pipe_fail

  (($# <= 1)) || {
    print -u2 -r -- 'Usage: dsh [container]'
    return 2
  }

  local container="${1}" selected
  if [[ -z "${container}" ]]; then
    ((${+commands[fzf]})) || {
      print -u2 -r -- 'dsh: fzf not found'
      return 127
    }
    local running
    running="$(docker ps -q)" || return
    [[ -n "${running}" ]] || {
      print -u2 -r -- 'No docker containers running!'
      return 1
    }
    selected="$(
      docker ps --format '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}' |
        fzf -1 --delimiter=$'\t' --with-nth=2..
    )" || return 1
    container="${selected%%$'\t'*}"
  fi

  local -a flags=(-i)
  [[ -t 0 && -t 1 ]] && flags+=(-t)
  docker exec -e TERM -e COLORTERM "${flags[@]}" "${container}" sh -c \
    'if [ -x /bin/bash ]; then exec /bin/bash; else exec /bin/sh; fi'
}

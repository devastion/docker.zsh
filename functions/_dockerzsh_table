#!/usr/bin/env zsh

_dockerzsh_table() {
  emulate -L zsh -o pipe_fail

  local field template=''
  for field in ${=1}; do
    # "-" keeps empty fields from collapsing in column(1).
    template+="{{or .${field} \"-\"}}"$'\t'
  done
  shift

  docker "$@" --format "${template%$'\t'}" | column -t -s $'\t' -c "${COLUMNS:-120}"
}

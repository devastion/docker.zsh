#!/usr/bin/env zsh
# desc: Print the IP address of a container

dip() {
  emulate -L zsh
  if (($# != 1)); then
    print -u2 -r -- 'Usage: dip <container>'
    return 2
  fi
  docker inspect -f '{{range $name, $net := .NetworkSettings.Networks}}{{printf "%s: %s\n" $name $net.IPAddress}}{{end}}' "${1}"
}

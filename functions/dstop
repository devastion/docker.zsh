#!/usr/bin/env zsh
# desc: Stop all running containers

dstop() {
  emulate -L zsh

  local timeout
  zstyle -s ':docker:dstop' timeout timeout || timeout=5

  local -a containers=()
  containers=("${(@f)$(docker ps -q)}") || return
  containers=("${(@)containers:#}")
  if ((${#containers} == 0)); then
    print -u2 -r -- 'No docker containers running!'
    return 1
  fi

  print -r -- 'Stopping all docker containers...'
  docker stop -t "${timeout}" "${containers[@]}" || return
  print -r -- 'All docker containers are stopped!'
}

#!/usr/bin/env zsh
# desc: Run a command (default: /bin/sh) in a running container

dexe() {
  emulate -L zsh
  (($#)) || {
    print -u2 -r -- 'Usage: dexe <container> [command [argument...]]'
    return 2
  }
  local container="${1}"
  shift
  (($#)) || set -- /bin/sh
  local -a flags=(-i)
  [[ -t 0 && -t 1 ]] && flags+=(-t)
  docker exec "${flags[@]}" "${container}" "$@"
}

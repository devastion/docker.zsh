#!/usr/bin/env zsh
# desc: Run a command (default: a shell) in a running container

dexe() {
  emulate -L zsh
  (($#)) || {
    print -u2 -r -- 'Usage: dexe <container> [command [argument...]]'
    return 2
  }
  local container="${1}"
  shift
  (($#)) || set -- /bin/sh
  docker exec -it "${container}" "$@"
}

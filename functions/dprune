#!/usr/bin/env zsh
# desc: Prune unused Docker resources after confirmation

dprune() {
  emulate -L zsh
  local -a all=() volumes=()
  zparseopts -D -F -- a=all v=volumes || return 2
  if (($#)); then
    print -u2 -r -- 'Usage: dprune [-a] [-v]'
    return 2
  fi
  ((${+commands[docker]})) || {
    print -u2 -r -- 'dprune: docker not found'
    return 127
  }

  local context
  context="$(docker context show)" || return
  print -r -- "Docker context: ${context}"

  local what='unused Docker resources'
  ((${#all})) && what+=', all unused images'
  ((${#volumes})) && what+=', and all unused volumes'
  __dockerzsh_confirm "Prune ${what}?" || return 1

  local -a args=(--force)
  ((${#all})) && args+=(-a)
  ((${#volumes})) && args+=(--volumes)
  docker system prune "${args[@]}"
}
